{
  "action": {
    "default_icon": {
      "16": "images/16.png",
      "19": "images/19.png",
      "32": "images/32.png",
      "38": "images/38.png",
      "48": "images/48.png",
      "64": "images/64.png",
      "128": "images/128.png"
    },
    "default_popup": "bluePopup.html",
    "default_title": "__MSG_extName__"
  },
  "background": {
    "service_worker": "blueBackground.js",
    "type": "module"
  },
  "commands": {
    "show-popup": {
      "description": "Show extension popup",
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      }
    }
  },
  "content_scripts": [
    {
      "css": [],
      "js": [
        "loader.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end"
    }
  ],
  "default_locale": "en",
  "description": "__MSG_extShortDesc__",
  "externally_connectable": {
    "matches": [
      "*://*.aitopia.ai/*",
      "*://*.chatgptextension.ai/*"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "images/16.png",
    "19": "images/19.png",
    "32": "images/32.png",
    "38": "images/38.png",
    "48": "images/48.png",
    "64": "images/64.png",
    "128": "images/128.png"
  },
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "permissions": [
    "storage",
    "scripting",
    "system.display",
    "contextMenus"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "2.0.0",
  "key": "",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "*.png",
        "*.svg",
        "*.otf",
        "*.mp4",
        "*.webm",
        "*.js",
        "*.css",
        "*.woff",
        "./aitopia/assets/images/*",
        "./aitopia/assets/videos/*"
      ],
      "use_dynamic_url": false
    }
  ]
}