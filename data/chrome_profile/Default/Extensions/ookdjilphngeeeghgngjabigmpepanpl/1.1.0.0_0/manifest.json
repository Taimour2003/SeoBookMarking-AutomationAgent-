{
   "action": {
      "default_icon": {
         "128": "icons/128x128.png",
         "16": "icons/16x16.png",
         "32": "icons/32x32.png",
         "48": "icons/48x48.png"
      }
   },
   "background": {
      "service_worker": "service-worker-loader.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "assets/content.js-DuIExTZX.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; script-src-elem 'self' "
   },
   "default_locale": "en",
   "description": "Simple yet powerful Cookie Editor that allow you to quickly create, edit and delete cookies without leaving your tab.",
   "externally_connectable": {
      "matches": [ "*://localhost/*", "*://127.0.0.1/*", "https://cookieeditor.org/*", "https://extension.vn/*" ]
   },
   "host_permissions": [ "https://*/*", "http://*/*" ],
   "icons": {
      "128": "icons/128x128.png",
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Cookie Editor",
   "optional_permissions": [ "browsingData", "contextMenus", "storage", "alarms" ],
   "options_ui": {
      "open_in_tab": true,
      "page": "pages/import.html"
   },
   "permissions": [ "cookies", "sidePanel", "tabs" ],
   "short_name": "Cookie Editor",
   "side_panel": {
      "default_path": "pages/sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
