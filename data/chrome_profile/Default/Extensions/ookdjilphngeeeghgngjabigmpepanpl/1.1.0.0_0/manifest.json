   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "images/*", "pages/*", "gifs/*", "fonts/*", "css/*", "scripts/*", "assets/content.js-DuIExTZX.js" ],
      "use_dynamic_url": false
   } ]
